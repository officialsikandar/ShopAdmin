# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB database (Required on Vercel).
MONGODB_URI=""

# MONGODB_MAX_POOL_SIZE: Optional max Mongoose connection pool size per serverless container (default 15 on Vercel).
MONGODB_MAX_POOL_SIZE="15"

# JWT_SECRET: Signing secret for customer and admin JWT authentication tokens (recommended 32+ chars on Vercel).
JWT_SECRET=""

# ADMIN_INITIAL_PASSWORD: Optional initial password for the seeded Super Admin account (defaults to Admin@123 if unset).
ADMIN_INITIAL_PASSWORD=""
